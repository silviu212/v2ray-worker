# Copiază în /etc/movsim/<site>.env (ex. /etc/movsim/silviu.env) și completează.
# Fișierul conține secrete: chmod 600, proprietar root.

# Eticheta site-ului (apare pe comenzi, la Stripe și la furnizor)
SITE_ID=silviu
# Portul intern; fiecare site de pe același VPS are alt port
PORT=3001
# Adresa publică, folosită în linkurile din email și la Stripe
PUBLIC_URL=https://exemplu-silviu.ro
# Parola pentru /admin.html (generează una: openssl rand -hex 24)
ADMIN_TOKEN=
# Număr WhatsApp, format internațional fără + (gol = butonul nu apare)
WHATSAPP_NUMBER=
# Cheia secretă Stripe. Gol = plată SIMULATĂ (nu folosi așa pentru vânzări reale)
STRIPE_SECRET_KEY=
